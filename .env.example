# Postgres connection string (required).
# Neon pooled URL works as-is:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Local `npx prisma dev` server (append pgbouncer=true because it sits behind a transaction pooler):
#   postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true
DATABASE_URL=""

# Optional: Google sign-in. Leave blank to offer email + password only.
# Create an OAuth client (Web application) in Google Cloud Console and add
#   <your origin>/api/auth/google/callback
# as an authorised redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: public origin used for the Google redirect URI when the app runs
# behind a proxy that rewrites the host. Usually not needed on Vercel.
APP_URL=""
